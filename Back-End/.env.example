# Email Configuration (for alerts; leave blank to use DEMO log-only mode)
# Use an app password if using Gmail. Do NOT commit real secrets.
EMAIL_USER=
EMAIL_PASS=

# Firebase Configuration (optional - will use serviceAccountKey.json)
FIREBASE_PROJECT_ID= "ai-for-women-safety"   

# Server Configuration
PORT=5000

# Demo Mode Settings
DEMO_MODE=true

# Feature Config
ANCHOR_EMAIL_INTERVAL_MIN=1
ALERT_RADIUS_KM=2
